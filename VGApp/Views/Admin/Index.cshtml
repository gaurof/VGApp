@model IEnumerable<VGAppDb.Models.Game>

<div class="admin-games-page">
    <div class="games-header">
        <h2>Games Management</h2>
        <a asp-action="Create" class="create-game-btn">
            <i class="fas fa-plus"></i> Create New Game
        </a>
    </div>

    <div class="games-grid">
        @foreach (var game in Model)
        {
            <a class="game-card-a" asp-controller="Game" asp-action="Info" asp-route-gameName="@game.Name">
                <div class="admin-game-card">
                <div class="game-card-header">
                    <h3 class="game-title">@game.Name</h3>
                </div>
                <div class="game-card-actions">
                    <a style="text-decoration: none;" asp-action="Edit" asp-route-id="@game.Name" class="action-btn edit-btn">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <form asp-action="Delete" asp-route-id="@game.Name" method="post" class="delete-form">
                        <button type="submit" class="action-btn delete-btn"
                                onclick="return confirm('Are you sure you want to delete @game.Name?')">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
            </a>
        }
    </div>
</div>