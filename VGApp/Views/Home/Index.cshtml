@using VGApp.ViewModels
@model UserWithGamesViewModel
@{
    var currentUser = Model.User ?? new VGAppDb.Models.User();
    var games = Model.Games;
}

<div class="container game-collection">
    <div class="collection-header">
        <h2>Our Game Collection</h2>
        <p>Track the games you played! Keep track of the ones you want to try! Share your favorites!</p>
    </div>

    <div class="game-grid">
        @foreach (var game in games)
        {
            <a class="game-card" asp-controller="Game" asp-action="Info" asp-route-gameName="@game.Name">
                <img src="@game.PosterUrl" alt="@game.Name" class="game-poster">
                <div class="game-info-overlay">
                    <img class="game-logo" src="@game.LogoUrl">
                    <div class="game-stats">
                        <span>@game.ReleaseYear</span>
                        <span>$@game.PriceUSD.ToString("0.00")</span>
                        <div class="played-indicator @(currentUser.HasPlayed(game) ? "played" : "")"
                             title="@(currentUser.HasPlayed(game) ? "Played" : "Not played")">
                            <i class="fas @(currentUser.HasPlayed(game) ? "fa-check" : "fa-gamepad")"></i>
                        </div>
                    </div>
                </div>
            </a>


        }
    </div>
</div>